{
  "name": "مستخرج النصوص الذكي | Pro OCR Extractor",
  "short_name": "Pro OCR",
  "description": "استيراد واستخراج النصوص من أي صورة باحترافية عالية باللغة العربية والإنجليزية",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#2563eb",
  "orientation": "portrait",
  "dir": "rtl",
  "lang": "ar",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shared_image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
